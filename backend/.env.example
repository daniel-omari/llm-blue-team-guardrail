# Copy to .env and fill in. All values are optional for local/demo use.

# Postgres connection (omit to run without request logging)
# Defaults to a local SQLite file (./guardrail.db) when unset, so /stats
# works with no setup. Set this to Postgres for Docker/production:
# DATABASE_URL=postgresql+psycopg://guardrail:guardrail@localhost:5432/guardrail

# Admin-only /history endpoint (returns raw prompts). Leave unset to keep it off;
# set a long random value to enable it, then send "Authorization: Bearer <token>".
# ADMIN_TOKEN=

# Hosted LLM for the judge layer (leave LLM_API_KEY empty to run heuristics-only).
# Anthropic (the default):
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Or any OpenAI-compatible provider, e.g. Groq's free tier:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low
# Optional: sampling temperature (unset = provider default) and schema-constrained
# JSON for the judge (on by default; set false for a provider that rejects it).
# LLM_TEMPERATURE=
# LLM_STRUCTURED_OUTPUT=true

# When a configured judge can't be reached: "open" allows and flags the decision as
# degraded (demo), "closed" blocks (production). Invalid judge replies always block.
# JUDGE_FAILURE_MODE=open
# A rate-limited judge call is retried once if the provider asks to wait at most
# this many seconds (0 = never retry). Recent verdicts are cached by exact text.
# LLM_RETRY_MAX_WAIT_SECONDS=5
# JUDGE_CACHE_SIZE=1000

# RAG demo (optional): the local embedding model and how many chunks to retrieve
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_TOP_K=4

# Logged checks are deleted after this many days (0 keeps them forever)
# LOG_RETENTION_DAYS=30

# Rate limits for POST /classify, /rag/ask and /mcp, per client and across all
# clients (requests per minute, 0 = off). Behind a reverse proxy, set how many
# proxies append to X-Forwarded-For so clients can be told apart.
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_GLOBAL_PER_MINUTE=60
# TRUSTED_PROXY_HOPS=0

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
