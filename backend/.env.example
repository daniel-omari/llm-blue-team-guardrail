# Copy to .env and fill in. All values are optional for local/demo use.

# Postgres connection (omit to run without request logging)
# Defaults to a local SQLite file (./guardrail.db) when unset, so /stats
# works with no setup. Set this to Postgres for Docker/production:
# DATABASE_URL=postgresql+psycopg://guardrail:guardrail@localhost:5432/guardrail

# Admin-only /history endpoint (returns raw prompts). Leave unset to keep it off;
# set a long random value to enable it, then send "Authorization: Bearer <token>".
# ADMIN_TOKEN=

# Hosted LLM for the judge layer (leave LLM_API_KEY empty to run heuristics-only).
# Anthropic (the default):
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Or any OpenAI-compatible provider, e.g. Groq's free tier:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low

# RAG demo (optional): the local embedding model and how many chunks to retrieve
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_TOP_K=4

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
